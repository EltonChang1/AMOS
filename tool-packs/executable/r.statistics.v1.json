{
  "schema_version": 1,
  "tool_id": "r.statistics.v1",
  "display_name": "Governed R statistics",
  "description": "Runs one allowlisted R statistical method over a bounded inline verified table without evaluating submitted R source.",
  "availability": "plan_step",
  "evaluation_only": true,
  "runtime": { "kind": "r", "audience": "r-worker", "entrypoint": "toolbox:r_statistics", "image_digest": null },
  "operations": ["analyze"],
  "source_policy": { "required": false, "read_only": true, "relations_parameter": null },
  "parameter_schema": {
    "type": "object",
    "properties": {
      "columns": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 128 }, "minItems": 2, "maxItems": 128, "uniqueItems": true },
      "rows": { "type": "array", "items": { "type": "array", "items": { "type": "scalar" }, "minItems": 2, "maxItems": 128 }, "minItems": 2, "maxItems": 50000 },
      "method": { "type": "string", "enum": ["linear_regression", "welch_t_test", "chi_squared_test"] },
      "outcome": { "type": "string", "minLength": 1, "maxLength": 128 },
      "predictors": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 128 }, "minItems": 1, "maxItems": 64, "uniqueItems": true },
      "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
    },
    "required": ["columns", "rows", "method", "outcome", "predictors", "seed"],
    "additionalProperties": false
  },
  "output_schema": { "type": "object", "properties": {
    "method": { "type": "string" },
    "estimates": { "type": "object", "properties": {}, "additionalProperties": true },
    "diagnostics": { "type": "object", "properties": {}, "additionalProperties": true }
  }, "required": ["method", "estimates", "diagnostics"], "additionalProperties": false },
  "resource_limits": { "max_seconds": 60, "max_rows": 50000, "max_bytes": 10000000, "max_memory_mb": 1024 },
  "network_policy": "deny_all",
  "determinism": { "deterministic": true, "seed_parameter": "seed", "records_runtime_version": true },
  "verifier_profile": "r.statistics.v1"
}
