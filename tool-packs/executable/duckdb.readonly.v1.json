{
  "schema_version": 1,
  "tool_id": "duckdb.readonly.v1",
  "display_name": "Read-only DuckDB",
  "description": "Runs one read-only SELECT against a bounded in-memory table named input_data with external access disabled.",
  "availability": "plan_step",
  "evaluation_only": true,
  "runtime": { "kind": "python", "audience": "duckdb-worker", "entrypoint": "toolbox:duckdb_query", "image_digest": null },
  "operations": ["query"],
  "source_policy": { "required": false, "read_only": true, "relations_parameter": null },
  "parameter_schema": { "type": "object", "properties": {
    "columns": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 128 }, "minItems": 1, "maxItems": 128, "uniqueItems": true },
    "rows": { "type": "array", "items": { "type": "array", "items": { "type": "scalar" }, "minItems": 1, "maxItems": 128 }, "minItems": 1, "maxItems": 50000 },
    "sql": { "type": "string", "minLength": 1, "maxLength": 32768 }
  }, "required": ["columns", "rows", "sql"], "additionalProperties": false },
  "output_schema": { "type": "array", "items": { "type": "object", "properties": {}, "additionalProperties": true }, "maxItems": 50000 },
  "resource_limits": { "max_seconds": 120, "max_rows": 50000, "max_bytes": 50000000, "max_memory_mb": 2048 },
  "network_policy": "deny_all",
  "determinism": { "deterministic": true, "seed_parameter": null, "records_runtime_version": true },
  "verifier_profile": "duckdb.readonly.v1"
}
